# Kaizen · variables del entorno LOCAL
# Copia este archivo como .env (cp .env.ejemplo .env). Docker Compose lo lee solo.
# Estos valores son SOLO PARA DESARROLLO EN TU MÁQUINA: no son los de producción
# y no deben usarse en ningún servidor. El archivo .env no se sube a Git.

# ---------------- PostgreSQL ----------------
# Superusuario local (solo para administrar y poblar; la API NUNCA lo usa)
POSTGRES_PASSWORD=postgres_local_dev
# Rol kaizen_api: con este se conecta la API (mismo nombre de variable que en producción)
KAIZEN_DB_PASSWORD=kaizen_api_local_dev
# Rol kaizen_etl: para el proceso ETL (solo lectura)
KAIZEN_ETL_DB_PASSWORD=kaizen_etl_local_dev
# Rol kaizen_tareas: tareas programadas (Escalera diaria, limpieza, particiones)
KAIZEN_TAREAS_DB_PASSWORD=kaizen_tareas_local_dev
# Cámbialo (p. ej. 55432) si ya tienes un PostgreSQL usando el 5432
KAIZEN_PG_PUERTO=5432

# ---------------- MongoDB ----------------
MONGO_ROOT_PASSWORD=mongo_root_local_dev
# Usuario kaizen_api de MongoDB (solo lectura de kaizen_analitica)
KAIZEN_MONGO_API_PASSWORD=mongo_api_local_dev
# Usuario kaizen_etl de MongoDB (lectura y escritura)
KAIZEN_MONGO_ETL_PASSWORD=mongo_etl_local_dev
KAIZEN_MONGO_PUERTO=27017

# ---------------- Llaves de la aplicación ----------------
# Formato: 64 caracteres hexadecimales (32 bytes). La API debe usar EXACTAMENTE estas
# llaves en local; si no, el login y las cápsulas de los datos de prueba no coinciden.
# En producción se generan otras, en el servidor, con: openssl rand -hex 32
KAIZEN_EMAIL_HMAC_KEY=6c6f63616c2d6465762d686d61632d6b65792d6b61697a656e2d323032362d31
KAIZEN_CAPSULA_KEY_V1=6c6f63616c2d6465762d6165732d6b65792d6b61697a656e2d32303236212121

# ---------------- Firma de los JWT (Ed25519) ----------------
# Semilla de 32 bytes en base64, SOLO DE DESARROLLO (la de producción es otra y vive en nodo1).
# Uso: Ed25519PrivateKey.from_private_bytes(base64.b64decode(KAIZEN_JWT_LLAVE_PRIVADA))
KAIZEN_JWT_LLAVE_PRIVADA=3bVR5IELiYgrz5ubR9bihOu6KbgPoz7/9Q3iLjIQ6lw=
KAIZEN_JWT_KID=kaizen-dev

# ---------------- Zona horaria por omisión ----------------
# La que usa la API si la app no manda la cabecera X-Zona-Horaria (contrato §1.1)
KAIZEN_ZONA_HORARIA_DEFECTO=America/Mexico_City

# ---------------- Correo (recuperación de contraseña) ----------------
# En local los correos los atrapa Mailpit: ábrelos en http://localhost:8025
KAIZEN_SMTP_HOST=localhost
KAIZEN_SMTP_PUERTO=1025
KAIZEN_SMTP_USUARIO=
KAIZEN_SMTP_CONTRASENA=
# starttls | ssl | ninguno   (Mailpit: ninguno; Gmail o Brevo: starttls en el 587)
KAIZEN_SMTP_TLS=ninguno
KAIZEN_SMTP_REMITENTE="Kaizen <no-responder@kaizen.test>"
# Página que abre el enlace del correo; el token va como ?token=...
KAIZEN_URL_RESTABLECER=http://localhost:8080/restablecer

# ---------------- Cuentas de prueba ----------------
# Contraseña de TODAS las cuentas que crea el poblador
KAIZEN_DEMO_PASSWORD=KaizenDemo2026!
